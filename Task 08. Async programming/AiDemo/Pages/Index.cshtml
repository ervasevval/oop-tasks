@page
@model IndexModel

@{
    ViewData["Title"] = "AI Demo";
}

<div class="container mt-4">

    <h1>AI Image Generator</h1>

    <form method="post" asp-page-handler="GenerateImage" class="mt-4">

        <div class="mb-3">
            <label asp-for="Prompt" class="form-label">
                Describe the image
            </label>

            <input asp-for="Prompt" class="form-control" placeholder="Example: a futuristic city skyline at sunset" />
        </div>

        <button type="submit" class="btn btn-primary">
            Generate Image
        </button>

    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ImageMessage))
    {
        <div class="alert alert-info mt-3">
            @Model.ImageMessage
        </div>
    }

    <div class="mt-4">
        <img src="@Model.GeneratedImageUrl" alt="Generated image" class="img-fluid border rounded"
             style="max-height: 420px;" />
    </div>

    <hr class="my-4" />

    <h2>AI Text Generator</h2>

    <form method="post" asp-page-handler="GenerateText">

        <div class="mt-4">
            <label asp-for="TextPrompt" class="form-label">
                Ask for text
            </label>

            <textarea asp-for="TextPrompt" class="form-control" rows="4"
                      placeholder="Example: Write a short product description for a travel app"></textarea>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">
                Generate Text
            </button>
        </div>

    </form>

    <div class="mt-3">
        <label class="form-label">
            Answer
        </label>

        <textarea class="form-control" rows="5" readonly>@Model.TextAnswer</textarea>
    </div>

</div>
